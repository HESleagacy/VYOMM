# VYOMM environment configuration example.
# Copy to `.env` and fill in real values only if you intend to use a
# real LLM provider. VYOMM does NOT require any key to run in trial
# or nvml-mock mode, and no key is required for acceptance testing.

# --- Environment mode ---
# One of: trial | nvml-mock | real-gpu
VYOMM_ENVIRONMENT_MODE=trial

# --- Optional LLM provider (OpenAI-compatible chat completions) ---
# Leave empty to use the deterministic offline fallback analysis.
# If a previous key was ever committed or shared, treat it as
# compromised and rotate it at the provider before reuse.
VYOMM_LLM_API_KEY=
VYOMM_LLM_BASE_URL=https://api.groq.com/openai/v1
VYOMM_LLM_MODEL=llama-3.3-70b-versatile

# --- Persistence ---
VYOMM_SQLITE_PATH=./data/vyomm.db
VYOMM_TELEMETRY_RETENTION_HOURS=24

# --- HTTP ---
VYOMM_API_ADDR=:8080
VYOMM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Observability ---
VYOMM_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VYOMM_OTEL_TRACES_SAMPLE_RATIO=0.2
VYOMM_LOG_LEVEL=info
